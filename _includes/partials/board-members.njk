<ul class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 list-unstyled board-grid">
  {%- for member in board %}
  {%- set words = member.name.split(" ") %}
  <li class="col">
    <div class="card h-100 board-member">
      {%- if member.photo %}
      <div class="board-portrait"{% if member.focus %} style="--portrait-focus: {{ member.focus }}"{% endif %}>
        {% portrait member.photo, "" %}
      </div>
      {%- else %}
      <div class="board-portrait board-portrait--placeholder">
        <span aria-hidden="true">{{ words | first | first }}{{ words | last | first }}</span>
      </div>
      {%- endif %}
      <div class="card-body d-flex flex-column">
        <h3 class="h5 card-title board-name">
          {%- if member.honorific %}<span class="board-honorific">{{ member.honorific }}</span> {% endif -%}
          {%- if member.url %}<a href="{{ member.url }}">{{ member.name }}</a>{% else %}{{ member.name }}{% endif -%}
        </h3>
        {%- if member.role %}
        <p class="board-role">{{ member.role }}</p>
        {%- endif %}
        <p class="board-affiliation">
          {%- for part in member.affiliation -%}
            {%- if part.url %}<a href="{{ part.url }}">{{ part.text }}</a>{% else %}{{ part.text }}{% endif -%}
            {%- if not loop.last %}, {% endif -%}
          {%- endfor -%}
        </p>
        <p class="card-text board-bio flex-grow-1">{{ member.bio }}</p>
      </div>
    </div>
  </li>
  {%- endfor %}
</ul>
