<!doctype html>
<html lang="{{ lang or metadata.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} – {{ metadata.title }}{% else %}{{ metadata.description }}{% endif %}</title>
    {%- set pageDescription = description or lead or metadata.description %}
    {%- set absolutePageUrl %}{{ page.url | url | absoluteUrl(metadata.url) }}{% endset %}
    {%- set ogImage = '/img/' + metadata.defaultCover %}
    {%- if coverImage %}{% set ogImage = coverImage if '/' in coverImage else '/img/' + coverImage %}{% endif %}
    <meta name="description" content="{{ pageDescription }}">
    {%- if author %}
    <meta name="author" content="{{ author }}">
    {%- endif %}
    <meta name="theme-color" content="#303F2F">
    <link rel="canonical" href="{{ absolutePageUrl }}">
    <meta property="og:site_name" content="{{ metadata.title }}">
    <meta property="og:type" content="{% if tags and 'posts' in tags %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ title or metadata.title }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ absolutePageUrl }}">
    <meta property="og:image" content="{{ ogImage | url | absoluteUrl(metadata.url) }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or metadata.title }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ ogImage | url | absoluteUrl(metadata.url) }}">
    {% favicon 'img/e-editiones-icon-color-300x300-square.svg' %}
    <link href="/assets/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ '/assets/css/prism-base16-monokai.dark.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/prism-diff.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/index.css' | url }}">
    <link rel="alternate" href="{{ metadata.feed.path | url }}" type="application/atom+xml" title="{{ metadata.title }}">
    <link rel="alternate" href="{{ metadata.jsonfeed.path | url }}" type="application/json" title="{{ metadata.title }}">
    {# <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script> #}
    {% block styles %}{% endblock %}
  </head>
  <body>
      <a class="skip-link" href="#main">Skip to main content</a>
      {{ content | safe }}

      <script src="/assets/scripts/bootstrap.bundle.min.js"></script>
      <script src="/assets/scripts/common.js"></script>
      {% block scripts %}{% endblock %}
      <!-- Matomo -->
      <script>
        var _paq = window._paq = window._paq || [];
        /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
        _paq.push(["setDoNotTrack", true]);
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function() {
          var u="https://stats.existsolutions.com/";
          _paq.push(['setTrackerUrl', u+'matomo.php']);
          _paq.push(['setSiteId', '2']);
          var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
          g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
        })();
      </script>
      <!-- End Matomo Code -->
  </body>
</html>
